<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MimaEmuPrinter.App.ViewModels"
        x:Class="MimaEmuPrinter.App.Views.EventsWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MimaEmuPrinter - Événements"
        Width="400" Height="590" MinWidth="360" MinHeight="400"
        ShowInTaskbar="False" WindowStartupLocation="Manual">

	<Border Background="#F1F3F5" Padding="12">
		<Border Background="White" BorderBrush="#D5D9DE" BorderThickness="1" CornerRadius="6" Padding="12">
			<DockPanel>
				<TextBlock DockPanel.Dock="Top" Text="Événements de panne" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,2" />
				<TextBlock DockPanel.Dock="Top" Text="Effet immédiat, y compris pendant une connexion ouverte."
				           FontSize="11" Opacity="0.65" Margin="0,0,0,8" />
				<Button DockPanel.Dock="Bottom" Content="Tout effacer" Command="{Binding ClearAllCommand}"
				        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,8,0,0" />
				<ScrollViewer VerticalScrollBarVisibility="Auto">
					<ItemsControl ItemsSource="{Binding Faults}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="vm:FaultItemViewModel">
								<Grid ColumnDefinitions="*,Auto" Margin="0,1" ToolTip.Tip="{Binding Effect}">
									<StackPanel VerticalAlignment="Center">
										<TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
										<TextBlock Text="{Binding CommandHint}" FontSize="11" Opacity="0.65" />
									</StackPanel>
									<ToggleSwitch Grid.Column="1" OnContent="" OffContent="" Margin="8,0,0,0"
									              IsChecked="{Binding IsChecked, Mode=TwoWay}"
									              IsEnabled="{Binding CanToggle}" />
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
			</DockPanel>
		</Border>
	</Border>
</Window>
