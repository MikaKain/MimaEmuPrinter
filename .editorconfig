root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = false
indent_style = tab
indent_size = 4
tab_width = 4

# YAML does not allow tabs
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = block_scoped:suggestion

# MimaCafe conventions: using directives inside the namespace, CLR type names (Int32, String…)
csharp_using_directive_placement = inside_namespace:warning
dotnet_style_predefined_type_for_locals_parameters_members = false:warning
dotnet_style_predefined_type_for_member_access = false:warning
dotnet_diagnostic.IDE0065.severity = warning
dotnet_diagnostic.IDE0049.severity = warning

# EF Core migrations are generated by the tools: code style rules do not apply
[src/MimaCafe.Lib/Data/Migrations/*.cs]
generated_code = true